/* GridBackground's own USS class name changed between Unity versions ("grid-background" -> "unity-grid-background"),
   so #nodra-grid-background (the name NodraGraphView assigns it in code) is the one selector guaranteed to match
   regardless of Unity version - the two class selectors are kept alongside it just in case. */
#nodra-grid-background,
.grid-background,
.unity-grid-background {
    --grid-background-color: #1c1c1c;
    --line-color: rgba(255, 255, 255, 0.05);
    --thick-line-color: rgba(255, 255, 255, 0.1);
    --spacing: 25;
}

/* NodraNodeView tags its field container with this class. Every built-in field (FloatField, Vector2Field,
   Toggle, ...) uses this same "unity-base-field__label" class - including each of a Vector2/Vector3's own
   inner X/Y/Z sub-fields, which already default to a small, correctly-sized label on their own. max-width (not
   width/min-width - that was the bug: it forced X/Y's already-tiny labels wide too, leaving nothing for their
   actual input boxes) only caps labels that would otherwise be wider than that, i.e. just the outer ones
   ("Amplitude", "Offset", "Along Normal", ...), which is what actually needed the room given back to the field. */
.nodra-node-fields .unity-base-field__label {
    max-width: 90px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* NodraNodeView tags a Generator node's root with this class. The color lives in a custom property (rather than
   directly on the #title rule below) so it's a single value to tweak, and so it's easy to give other categories
   their own "-header-color" variable + class pair later following the same pattern. */
.nodra-node-generator {
    --nodra-generator-header-color: rgb(107, 73, 31);
}

.nodra-node-generator #title {
    background-color: var(--nodra-generator-header-color);
}

.nodra-node-output-outline {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    border-width: 2px;
    border-color: rgb(77, 217, 102);
    border-radius: 6px;
}
